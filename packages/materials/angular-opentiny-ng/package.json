{
  "name": "@opentiny/genui-sdk-materials-angular-opentiny-ng",
  "version": "0.0.1",
  "description": "OpenTiny Angular component materials and render-config for GenUI SDK",
  "author": "OpenTiny Team",
  "license": "MIT",
  "homepage": "https://opentiny.design/genui-sdk",
  "repository": {
    "type": "git",

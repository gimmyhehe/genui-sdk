# 服务端口（默认 3100）
PORT=3100

# MCP 传输方式: http | stdio（默认 http）
# MCP_TRANSPORT=http

# MCP 端点路径（默认 /mcp）
# MCP_PATH=/mcp

# MCP HTTP 会话上限与空闲过期（毫秒，默认 30 分钟）
# MCP_MAX_SESSIONS=64
# MCP_SESSION_IDLE_MS=1800000

# 上游 API 请求超时（毫秒，默认 60000）
# MCP_API_TIMEOUT_MS=60000

# parse_swagger 输入安全（默认仅允许内联 JSON/YAML，防 SSRF / 任意文件读）
# MCP_SWAGGER_ALLOW_INLINE=true
# MCP_SWAGGER_ALLOW_URL_FETCH=false
# MCP_SWAGGER_ALLOW_FILE_READ=false
# MCP_SWAGGER_ALLOW_LOCALHOST_URL=false
# MCP_SWAGGER_URL_HOST_ALLOWLIST=api.example.com,cdn.example.com
# MCP_SWAGGER_ALLOWED_FILE_DIRS=/absolute/path/to/openapi-specs

# Swagger/API 配置请通过 parse_swagger 工具在运行时传入，无需在此配置

# 集成到 genui-sdk-playground-server 时无需单独启动本服务：
# MCP 默认 http://localhost:3008/mcp

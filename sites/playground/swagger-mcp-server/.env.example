# 服务端口（默认 3100）
PORT=3100

# MCP 传输方式: http | stdio（默认 http）
# MCP_TRANSPORT=http

# MCP 端点路径（默认 /mcp）
# MCP_PATH=/mcp

# Swagger/API 配置请通过 parse_swagger 工具在运行时传入，无需在此配置

# 独立运行时的 Assets API（读取 assests 目录）:
# GET  /api/assets           列出文件
# GET  /api/assets/aad.json  获取文件内容

# 集成到 genui-sdk-playground-server 时无需单独启动本服务：
# MCP 默认 http://localhost:3008/mcp
# Assets 默认 http://localhost:3008/api/swagger-assets
